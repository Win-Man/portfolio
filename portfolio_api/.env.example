# 复制为 .env 后取消注释并修改

# ---- 数据库 ----
# 留空用默认 sqlite，留空用 sqlite:///./portfolio.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/portfolio

# ---- 服务 ----
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=false
# 生产应改为前端域名白名单，逗号分隔
# CORS_ORIGINS=https://portfolio.example.com

# ---- 缓存 ----
# 6 小时 TTL
# DIVIDEND_CACHE_TTL_SECONDS=21600

# ---- 外部数据源 ----
# TENCENT_QUOTE_URL=https://qt.gtimg.cn/q

# ---- 定时任务（后台管理页可看运行情况）----
# 下面五个任务默认**只在 A 股交易日**执行（周末与法定节假日自动跳过，
# 判断依据是 akshare 的真实交易日历，能处理调休与春节/国庆连休）。
# 想周末也跑（调试、补数据）时设为 false。
# SCHEDULE_TRADING_DAY_ONLY=true
# 观察池每日快照：收盘后抓行情 + TTM 分红写当天快照
# WATCHLIST_SNAPSHOT_ENABLED=true
# WATCHLIST_SNAPSHOT_TIME=15:30
# 投资组合价格刷新：把全部资产的最新价刷成当日行情价
# ASSET_PRICE_REFRESH_ENABLED=true
# ASSET_PRICE_REFRESH_TIME=15:05

# ---- 网络 / 代理 ----
# 行情请求默认直连（忽略 HTTP(S)_PROXY），避免本机代理（Clash/Surge 等）
# 把 eastmoney 之类的行情域名代理坏。需要走代理时改为 false。
# NET_BYPASS_PROXY=true
# 追加要绕过代理的域名，逗号分隔（与内置行情域名清单合并）
# NO_PROXY_HOSTS=my-quote.example

# ---- 每日日报（spec 004）----
# 两份日报 + 邮件推送，按顺序跑：15:05 价格 → 15:30 快照 → 15:40/15:45 日报 → 15:50 邮件
# DAILY_REPORT_PORTFOLIO_ENABLED=true
# DAILY_REPORT_PORTFOLIO_TIME=15:40
# DAILY_REPORT_WATCHLIST_ENABLED=true
# DAILY_REPORT_WATCHLIST_TIME=15:45
# 观察池没有持股数，盈亏按「每只投这么多钱」等权测算
# DAILY_REPORT_WATCHLIST_NOTIONAL=10000

# ---- 日报邮件推送 ----
# 把当天全部组合日报 + 观察池日报合成一封邮件发出
# DAILY_REPORT_MAIL_ENABLED=true
# DAILY_REPORT_MAIL_TIME=15:50
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SSL=true
# 登录账号（QQ 邮箱同时也是发件人，两者必须一致，否则被拒信）
# MAIL_USERNAME=you@qq.com
# ⚠ 这里是「授权码」，不是登录密码：
#    邮箱设置 → 账户 → 开启 POP3/SMTP 服务 → 生成授权码
#    填登录密码会报 535 Authentication failed
# MAIL_PASSWORD=
# 收件人，逗号分隔；留空则发给自己
# MAIL_RECIPIENTS=you@qq.com
# 发件人显示名 / 主题前缀
# MAIL_FROM_NAME=投资组合日报
# MAIL_SUBJECT_PREFIX=投资日报
